# ==============================================================
# KuzmichAI Environment Configuration
# Copy this file to .env and adjust the values for your system
# ==============================================================

# --- Hardware & OS ---
# Set to the appropriate GPU index for your server (e.g., RTX 5070) or robot
CUDA_VISIBLE_DEVICES=0
# "g1" for robot hardware, "local" for testing on a PC
VOICE_ENGINE_AUDIO=local 

# --- Network & DDS ---
VOICE_ENGINE_DDS_INTERFACE=eth0
VOICE_ENGINE_MIC_LOCAL_IP=192.168.123.164
VOICE_ENGINE_ROBOT_IP=192.168.1.103
VOICE_ENGINE_SERVER_URL=http://192.168.10.179:8002

# --- Model Paths (Absolute or relative to project root) ---
VOICE_ENGINE_LLM_MODEL=models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
VOICE_ENGINE_WHISPER_MODEL=large-v3-turbo
VOICE_ENGINE_NEMO_MODEL=nvidia/parakeet-tdt-0.6b-v3

# --- Behavior & Thresholds ---
VOICE_ENGINE_NOISE_THRESHOLD=0.6
VOICE_ENGINE_TTS_TEMPO=1.0
VOICE_ENGINE_TTS_GAIN_DB=16
VOICE_ENGINE_MAX_HISTORY_TURNS=5
